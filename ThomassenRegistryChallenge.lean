    (hboundary : ∀ x, OnOuterFace M outer x → x ∉ B → 2 ≤ (L x).card)
    (hinterior : ∀ x, ¬ OnOuterFace M outer x → 3 ≤ (L x).card)
    (hshort : ∀ {x y}, G.Adj x y → (L x).card ≤ 2 → (L y).card ≤ 2 → x ∈ B ∧ y ∈ B) :
