/-!
# Combinatorial plane embeddings of simple graphs

Planarity is represented **combinatorially**, by rotation systems of genus zero
(Heffter–Edmonds–Ringel).  The darts of `G` are Mathlib's `G.Dart` (ordered pairs of adjacent
vertices).

* `dartSymm G` is the edge involution `d ↦ d.symm`.
* `IsRotationSystem G σ`: `σ` keeps the tail of every dart, and all darts with the same tail
  form a single `σ`-cycle; i.e. `σ` is a cyclic order of the darts around each vertex.
* `PlaneMap G` is an *embedded plane graph*: a rotation system whose hypermap
  `(σ, dartSymm G)` has Euler defect zero.  Its faces are the cycles of the face permutation
  `facePerm = σ * dartSymm G`, i.e. `d ↦ σ (d.symm)`: the face to the left of `d` continues with
  the dart following the reverse of `d` around the head of `d`.
* `IsPlanar G` asserts that *some* plane map of `G` exists.

The Euler defect counts darts, connected components (orbits of the group generated by the
rotation and the edge involution), vertices, edges and faces.  For a rotation system,
`PlaneMap.euler` gives Euler's formula `V - E + F = 2 K`, where `V` is the number of
`σ`-cycles (vertices carrying an edge), `E` the number of edges (`card_edgeSet_eq_cycleCount`),
`F` the number of faces and `K` the number of components containing an edge.  The condition is
taken over *all* components at once and is equivalent to every component being a sphere,
because the genus of every component is nonnegative (`eulerDefect_nonneg`).  Isolated vertices
carry no darts and play no role; the empty and edgeless graphs are planar
(`isPlanar_of_edgeless`).
-/

namespace LeanPool.K5MinorFreeChoosability

open Equiv Equiv.Perm

variable {V : Type*} (G : SimpleGraph V)

/-- The edge involution `d ↦ d.symm` on the darts of `G`. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

@[simp] theorem dartSymm_apply (d : G.Dart) : dartSymm G d = d.symm := rfl

/-- A rotation system: a cyclic order of the darts leaving each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- An embedded plane graph, represented by a genus-zero rotation system. -/
structure PlaneMap where
  /-- The rotation: the next dart counterclockwise around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` has a plane embedding. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

namespace PlaneMap

variable {G} (M : PlaneMap G)

/-- The face permutation `d ↦ rot (d.symm)`. -/
def facePerm : Perm G.Dart := M.rot * dartSymm G

theorem facePerm_apply (d : G.Dart) : M.facePerm d = M.rot d.symm := rfl

/-- The faces of a plane map: the cycles of the face permutation. -/
def Face : Type _ := Quotient (SameCycle.setoid M.facePerm)

/-- The number of faces. -/
noncomputable def numFaces : ℕ := cycleCount M.facePerm

end PlaneMap

/-! ### Interpretation of the counts -/

theorem sameCycle_dartSymm_iff {d e : G.Dart} :
    SameCycle (dartSymm G) d e ↔ e = d ∨ e = d.symm := by
  constructor
  · intro h
    have := sameCycle_of_step (Setoid.ker SimpleGraph.Dart.edge) (fun z => by
      rw [Setoid.ker_def]; simp) h
    rw [Setoid.ker_def, SimpleGraph.dart_edge_eq_iff] at this
    rcases this with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr (by simp)
  · rintro (rfl | rfl)
    · exact SameCycle.refl _ _
    · exact ⟨1, by simp⟩

/-- The cycles of the edge involution are the edges. -/
theorem card_edgeSet_eq_cycleCount : Nat.card G.edgeSet = cycleCount (dartSymm G) := by
  unfold cycleCount numClasses
  symm
  refine Nat.card_congr (Equiv.ofBijective (Quotient.lift (fun d : G.Dart => ⟨d.edge, d.edge_mem⟩)
    (fun a b h => ?_)) ⟨?_, ?_⟩)
  · have h' : SameCycle (dartSymm G) a b := h
    rw [sameCycle_dartSymm_iff] at h'
    rcases h' with rfl | rfl
    · rfl
    · simp
  · intro p q hpq
    induction p using Quotient.inductionOn with
    | h a =>
    induction q using Quotient.inductionOn with
    | h b =>
    apply Quotient.sound
    change SameCycle _ _ _
    have : a.edge = b.edge := congrArg Subtype.val hpq
    rw [SimpleGraph.dart_edge_eq_iff] at this
    rw [sameCycle_dartSymm_iff]
    rcases this with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr (by simp)
  · rintro ⟨e, he⟩
    induction e using Sym2.ind with
    | h x y =>
    exact ⟨Quotient.mk _ ⟨(x, y), he⟩, rfl⟩

theorem card_dart_eq_two_mul [Finite V] : Nat.card G.Dart = 2 * cycleCount (dartSymm G) := by
  classical
  have := Fintype.ofFinite V
  rw [← card_edgeSet_eq_cycleCount, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card,
    SimpleGraph.dart_card_eq_twice_card_edges, SimpleGraph.edgeFinset_card]

/-- **Euler's formula** for a plane map: `V - E + F = 2 K`, where `V` counts rotation cycles
(vertices with an edge), `E` edges, `F` faces and `K` components. -/
theorem PlaneMap.euler [Finite V] {G : SimpleGraph V} (M : PlaneMap G) :
    (cycleCount M.rot : ℤ) - Nat.card G.edgeSet + M.numFaces =
      2 * numComponents M.rot (dartSymm G) := by
  have h := M.eulerDefect_eq_zero
  have h2 := card_dart_eq_two_mul G
  rw [card_edgeSet_eq_cycleCount]
  unfold eulerDefect at h
  unfold PlaneMap.numFaces PlaneMap.facePerm
  omega

/-- A graph without edges is planar (with the empty rotation system). -/
theorem isPlanar_of_edgeless [Finite V] (h : ∀ u v, ¬ G.Adj u v) : IsPlanar G := by
  have hD : IsEmpty G.Dart := ⟨fun d => h _ _ d.adj⟩
  refine ⟨⟨1, ⟨fun d => hD.elim d, fun d => hD.elim d⟩, ?_⟩⟩
  unfold eulerDefect numComponents cycleCount numClasses
  simp [Nat.card_of_isEmpty]

end LeanPool.K5MinorFreeChoosability

