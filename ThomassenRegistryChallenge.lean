/-!
# The Euler defect of a pair of permutations

A pair of permutations `(σ, α)` of a finite set `D` of *darts* is a (combinatorial) hypermap.
For a graph map, `σ` is the rotation (vertex) permutation, `α` the edge involution and
`σ * α` the face permutation.  Writing `c(π)` for the number of cycles of `π`
(fixed points included) and `K` for the number of orbits of the group generated by `σ` and
`α`, the *Euler defect*

  `eulerDefect σ α = |D| + 2 K - c(σ) - c(α) - c(σ α)`

is twice the genus.  We prove:

* `eulerDefect_nonneg`: the defect is never negative (Euler's inequality);
* the elementary operations used for deletion and contraction of edges never increase the
  defect: `eulerDefect_mul_swap_right` (split a cycle of `α`),
  `eulerDefect_removeFromCycle` (remove a dart from its `σ`-cycle) and
  `eulerDefect_merge` (merge the `σ`-cycles of two darts of an edge while detaching the edge);
* invariance under relabelling darts (`eulerDefect_permCongr`) and under adding darts fixed by
  both permutations (`eulerDefect_ofSubtype`).
-/

namespace LeanPool.K5MinorFreeChoosability

open Equiv Equiv.Perm

variable {D : Type*}

/-- The relation "in the same orbit of the group generated by `σ` and `α`". -/
def compSetoid (σ α : Perm D) : Setoid D where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = α a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `α` (connected components). -/
noncomputable def numComponents (σ α : Perm D) : ℕ := numClasses (compSetoid σ α)

/-- The Euler defect `|D| + 2 K - c(σ) - c(α) - c(σ α)` of the hypermap `(σ, α)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ α : Perm D) : ℤ :=
  (Nat.card D : ℤ) + 2 * (numComponents σ α : ℤ) - cycleCount σ - cycleCount α -
    cycleCount (σ * α)

theorem compSetoid_le (r : Setoid D) {σ α : Perm D} (hσ : ∀ z, r z (σ z))
    (hα : ∀ z, r z (α z)) {a b : D} (h : compSetoid σ α a b) : r a b := by
  change Relation.EqvGen _ a b at h
  induction h with
  | rel x y hxy =>
    rcases hxy with rfl | rfl
    · exact hσ x
    · exact hα x
  | refl x => exact r.refl x
  | symm x y _ ih => exact r.symm ih
  | trans x y z _ _ ih1 ih2 => exact r.trans ih1 ih2

theorem compSetoid_left (σ α : Perm D) (z : D) : compSetoid σ α z (σ z) :=
  Relation.EqvGen.rel _ _ (Or.inl rfl)

theorem compSetoid_right (σ α : Perm D) (z : D) : compSetoid σ α z (α z) :=
  Relation.EqvGen.rel _ _ (Or.inr rfl)

theorem compSetoid_of_sameCycle_left {σ α : Perm D} {a b : D} (h : SameCycle σ a b) :
    compSetoid σ α a b :=
  sameCycle_of_step _ (compSetoid_left σ α) h

theorem compSetoid_of_sameCycle_right {σ α : Perm D} {a b : D} (h : SameCycle α a b) :
    compSetoid σ α a b :=
  sameCycle_of_step _ (compSetoid_right σ α) h

theorem compSetoid_of_sameCycle_mul {σ α : Perm D} {a b : D} (h : SameCycle (σ * α) a b) :
    compSetoid σ α a b :=
  sameCycle_of_step _ (fun z => (compSetoid σ α).trans (compSetoid_right σ α z)
    (compSetoid_left σ α (α z))) h

section Swap

variable [DecidableEq D]

/-- A step of `π` is a step of `π * swap x y` up to the pair `(x, y)`. -/
theorem addPair_apply_of_mulSwap (s : Setoid D) (π : Perm D) (x y : D)
    (h : ∀ z, s z ((π * swap x y) z)) (z : D) : addPairSetoid s x y z (π z) := by
  by_cases hzx : z = x
  · subst hzx
    refine Or.inr (Or.inl ⟨s.refl _, ?_⟩)
    simpa using h y
  by_cases hzy : z = y
  · subst hzy
    refine Or.inr (Or.inr ⟨s.refl _, ?_⟩)
    simpa using h x
  · refine Or.inl ?_
    simpa [swap_apply_of_ne_of_ne hzx hzy] using h z

/-- A step of `π` is a step of `π * swap x y` once `x` and `y` are related. -/
theorem rel_apply_of_mulSwap (s : Setoid D) (π : Perm D) (x y : D)
    (h : ∀ z, s z ((π * swap x y) z)) (hxy : s x y) (z : D) : s z (π z) := by
  rcases addPair_apply_of_mulSwap s π x y h z with k | ⟨k1, k2⟩ | ⟨k1, k2⟩
  · exact k
  · exact s.trans (s.trans k1 hxy) k2
  · exact s.trans (s.trans k1 (s.symm hxy)) k2

variable [Finite D]

/-- The abstract defect comparison used for all elementary operations. -/
theorem eulerDefect_le_of_step {σ α σ' α' : Perm D} {a b x y : D} (hab : a ≠ b)
    (hc : cycleCount σ' + cycleCount α' = cycleCount σ + cycleCount α + 1)
    (hφ : σ' * α' = σ * α * swap a b)
    (hK1 : ∀ u v, compSetoid σ α u v → addPairSetoid (compSetoid σ' α') x y u v)
    (hK2 : compSetoid σ' α' a b → ∀ u v, compSetoid σ α u v → compSetoid σ' α' u v) :
    eulerDefect σ' α' ≤ eulerDefect σ α := by
  have hK : numComponents σ' α' ≤ numComponents σ α + 1 := by
    have h1 := numClasses_le_addPair_succ (compSetoid σ' α') x y
    have h2 := numClasses_le_of_le hK1
    unfold numComponents
    omega
  unfold eulerDefect
  by_cases hs : SameCycle (σ * α) a b
  · have h1 := cycleCount_mul_swap_of_sameCycle hab hs
    rw [hφ, h1]
    push_cast
    omega
  · have h1 := cycleCount_mul_swap_of_not_sameCycle hs
    have hs' : SameCycle (σ' * α') a b := hφ ▸ sameCycle_mulSwap_of_not hs
    have hK' : numComponents σ' α' ≤ numComponents σ α :=
      numClasses_le_of_le (hK2 (compSetoid_of_sameCycle_mul hs'))
    rw [hφ]
    omega

/-- Splitting a cycle of `α` (for a map: detaching the two darts of an edge from each other)
does not increase the defect. -/
theorem eulerDefect_mul_swap_right {σ α : Perm D} {x y : D} (hne : x ≠ y)
    (h : SameCycle α x y) : eulerDefect σ (α * swap x y) ≤ eulerDefect σ α := by
  refine eulerDefect_le_of_step (a := x) (b := y) (x := x) (y := y) hne ?_ (mul_assoc _ _ _)
    ?_ ?_
  · rw [cycleCount_mul_swap_of_sameCycle hne h]
    ring
  · intro u v huv
    exact compSetoid_le _ (fun z => Or.inl (compSetoid_left _ _ z))
      (addPair_apply_of_mulSwap _ α x y (compSetoid_right _ _)) huv
  · intro hxy u v huv
    exact compSetoid_le _ (compSetoid_left _ _)
      (rel_apply_of_mulSwap _ α x y (compSetoid_right _ _) hxy) huv

/-- Splitting a cycle of `σ` does not increase the defect. -/
theorem eulerDefect_mul_swap_left {σ α : Perm D} {x y : D} (hne : x ≠ y)
    (h : SameCycle σ x y) : eulerDefect (σ * swap x y) α ≤ eulerDefect σ α := by
  have hab : α⁻¹ x ≠ α⁻¹ y := fun e => hne (by simpa using congrArg α e)
  refine eulerDefect_le_of_step (a := α⁻¹ x) (b := α⁻¹ y) (x := x) (y := y) hab ?_ ?_ ?_ ?_
  · rw [cycleCount_mul_swap_of_sameCycle hne h]
    ring
  · rw [swap_apply_apply, inv_inv]
    group
  · intro u v huv
    exact compSetoid_le _ (addPair_apply_of_mulSwap _ σ x y (compSetoid_left _ _))
      (fun z => Or.inl (compSetoid_right _ _ z)) huv
  · intro hab' u v huv
    have hxy : compSetoid (σ * swap x y) α x y := by
      have h1 := compSetoid_right (σ * swap x y) α (α⁻¹ x)
      have h2 := compSetoid_right (σ * swap x y) α (α⁻¹ y)
      rw [show α (α⁻¹ x) = x by simp] at h1
      rw [show α (α⁻¹ y) = y by simp] at h2
      exact (compSetoid _ _).trans ((compSetoid _ _).trans ((compSetoid _ _).symm h1) hab') h2
    exact compSetoid_le _ (rel_apply_of_mulSwap _ σ x y (compSetoid_left _ _) hxy)
      (compSetoid_right _ _) huv

/-- Removing a dart from its `σ`-cycle does not increase the defect. -/
theorem eulerDefect_removeFromCycle (σ α : Perm D) (z : D) :
    eulerDefect (removeFromCycle σ z) α ≤ eulerDefect σ α := by
  by_cases hz : σ⁻¹ z = z
  · rw [removeFromCycle_eq_of_fixed hz]
  · exact eulerDefect_mul_swap_left hz (sameCycle_inv_apply_self σ z)

/-- Contraction step: if the two darts `x`, `y = α x` of an edge lie in different
`σ`-cycles, merging those cycles while detaching `x` from `y` does not increase the defect;
the face permutation is unchanged. -/
theorem eulerDefect_merge {σ α : Perm D} {x y : D} (hne : x ≠ y) (hαx : α x = y)
    (hαy : α y = x) (h : ¬ SameCycle σ x y) :
    eulerDefect (σ * swap x y) (α * swap x y) ≤ eulerDefect σ α := by
  have hc1 := cycleCount_mul_swap_of_not_sameCycle h
  have hαs : SameCycle α x y := ⟨1, by simp [hαx]⟩
  have hc2 := cycleCount_mul_swap_of_sameCycle hne hαs
  have hφ : σ * swap x y * (α * swap x y) = σ * α := by
    ext z
    simp only [Perm.mul_apply]
    by_cases hzx : z = x
    · subst hzx; simp [hαx, hαy]
    by_cases hzy : z = y
    · subst hzy; simp [hαx, hαy]
    have h1 : α z ≠ x := fun e => hzy (α.injective (e.trans hαy.symm))
    have h2 : α z ≠ y := fun e => hzx (α.injective (e.trans hαx.symm))
    rw [swap_apply_of_ne_of_ne hzx hzy, swap_apply_of_ne_of_ne h1 h2]
  have hxy : compSetoid (σ * swap x y) (α * swap x y) x y :=
    compSetoid_of_sameCycle_left (sameCycle_mulSwap_of_not h)
  have hK : numComponents (σ * swap x y) (α * swap x y) ≤ numComponents σ α := by
    refine numClasses_le_of_le (fun u v huv => ?_)
    exact compSetoid_le _ (rel_apply_of_mulSwap _ σ x y (compSetoid_left _ _) hxy)
      (rel_apply_of_mulSwap _ α x y (compSetoid_right _ _) hxy) huv
  unfold eulerDefect
  rw [hφ]
  omega

end Swap

/-- With `α = 1` the defect vanishes. -/
theorem eulerDefect_one_right [Finite D] (σ : Perm D) : eulerDefect σ 1 = 0 := by
  have hK : numComponents σ 1 = cycleCount σ := by
    refine numClasses_congr (fun a b => ⟨fun h => ?_, compSetoid_of_sameCycle_left⟩)
    exact compSetoid_le (SameCycle.setoid σ) (fun z => ⟨1, by simp⟩)
      (fun z => SameCycle.refl _ _) h
  unfold eulerDefect
  rw [hK, mul_one, cycleCount_one]
  ring

/-- **Euler's inequality** for hypermaps: the defect (twice the genus) is nonnegative. -/
theorem eulerDefect_nonneg [Finite D] (σ α : Perm D) : 0 ≤ eulerDefect σ α := by
  classical
  induction hm : Nat.card D - cycleCount α using Nat.strong_induction_on generalizing α with
  | _ m ih =>
  by_cases hα : α = 1
  · subst hα
    rw [eulerDefect_one_right]
  · obtain ⟨z, hz⟩ : ∃ z, α z ≠ z := by
      by_contra hcon
      push Not at hcon
      exact hα (Equiv.ext hcon)
    have hs : SameCycle α z (α z) := ⟨1, by simp⟩
    have hc := cycleCount_mul_swap_of_sameCycle (Ne.symm hz) hs
    have hle := cycleCount_le_card (α * swap z (α z))
    have h1 := ih (Nat.card D - cycleCount (α * swap z (α z))) (by omega) _ rfl
    exact h1.trans (eulerDefect_mul_swap_right (Ne.symm hz) hs)

/-! ### Relabelling darts and adding fixed darts -/

theorem sameCycle_permCongr_iff {D' : Type*} (e : D ≃ D') (π : Perm D) (a b : D) :
    SameCycle π a b ↔ SameCycle (e.permCongr π) (e a) (e b) := by
  constructor
  · intro h
    have := sameCycle_of_step (Setoid.comap e (SameCycle.setoid (e.permCongr π)))
      (fun z => by
        rw [Setoid.comap_rel]
        change SameCycle _ _ _
        have : (e.permCongr π) (e z) = e (π z) := by simp [permCongr_apply]
        rw [← this]
        exact ⟨1, by simp⟩) h
    rwa [Setoid.comap_rel] at this
  · intro h
    have := sameCycle_of_step (Setoid.comap e.symm (SameCycle.setoid π))
      (fun z => by
        rw [Setoid.comap_rel]
        change SameCycle _ _ _
        rw [permCongr_apply, symm_apply_apply]
        exact ⟨1, by simp⟩) h
    rw [Setoid.comap_rel, symm_apply_apply, symm_apply_apply] at this
    exact this

theorem cycleCount_permCongr {D' : Type*} (e : D ≃ D') (π : Perm D) :
    cycleCount (e.permCongr π) = cycleCount π :=
  (numClasses_congr_equiv e (sameCycle_permCongr_iff e π)).symm

theorem compSetoid_permCongr_iff {D' : Type*} (e : D ≃ D') (σ α : Perm D) (a b : D) :
    compSetoid σ α a b ↔ compSetoid (e.permCongr σ) (e.permCongr α) (e a) (e b) := by
  constructor
  · intro h
    have := compSetoid_le (Setoid.comap e (compSetoid (e.permCongr σ) (e.permCongr α)))
      (fun z => by
        rw [Setoid.comap_rel]
        have := compSetoid_left (e.permCongr σ) (e.permCongr α) (e z)
        simpa [permCongr_apply] using this)
      (fun z => by
        rw [Setoid.comap_rel]
        have := compSetoid_right (e.permCongr σ) (e.permCongr α) (e z)
        simpa [permCongr_apply] using this) h
    rwa [Setoid.comap_rel] at this
  · intro h
    have := compSetoid_le (Setoid.comap e.symm (compSetoid σ α))
      (fun z => by
        rw [Setoid.comap_rel, permCongr_apply, symm_apply_apply]
        exact compSetoid_left σ α _)
      (fun z => by
        rw [Setoid.comap_rel, permCongr_apply, symm_apply_apply]
        exact compSetoid_right σ α _) h
    rw [Setoid.comap_rel] at this
    simpa using this

/-- The defect does not depend on the names of the darts. -/
theorem eulerDefect_permCongr {D' : Type*} (e : D ≃ D') (σ α : Perm D) :
    eulerDefect (e.permCongr σ) (e.permCongr α) = eulerDefect σ α := by
  unfold eulerDefect numComponents
  rw [← permCongr_mul, cycleCount_permCongr, cycleCount_permCongr, cycleCount_permCongr,
    ← numClasses_congr_equiv e (compSetoid_permCongr_iff e σ α), Nat.card_congr e]

section Subtype

variable (p : D → Prop) [DecidablePred p]

theorem cycleCount_ofSubtype [Finite D] (π : Perm (Subtype p)) :
    cycleCount (ofSubtype π) = cycleCount π + Nat.card {x // ¬ p x} := by
  refine numClasses_eq_restrict _ p _ (fun a b => ?_) (fun a b ha h => ?_)
  · change SameCycle π a b ↔ SameCycle (ofSubtype π) a b
    conv_lhs => rw [← subtypePerm_ofSubtype π]
    exact sameCycle_subtypePerm
  · exact h.eq_of_left (ofSubtype_apply_of_not_mem π ha)

theorem compSetoid_ofSubtype_iff (σ α : Perm (Subtype p)) (a b : Subtype p) :
    compSetoid σ α a b ↔ compSetoid (ofSubtype σ) (ofSubtype α) a.1 b.1 := by
  constructor
  · intro h
    have := compSetoid_le (Setoid.comap Subtype.val (compSetoid (ofSubtype σ) (ofSubtype α)))
      (fun z => by
        rw [Setoid.comap_rel, ← ofSubtype_apply_coe]
        exact compSetoid_left _ _ _)
      (fun z => by
        rw [Setoid.comap_rel, ← ofSubtype_apply_coe]
        exact compSetoid_right _ _ _) h
    rwa [Setoid.comap_rel] at this
  · intro h
    let g : D → Quotient (compSetoid σ α) ⊕ D := fun u =>
      if hu : p u then Sum.inl (Quotient.mk _ ⟨u, hu⟩) else Sum.inr u
    have key : ∀ (π : Perm (Subtype p)), (∀ z, compSetoid σ α z (π z)) →
        ∀ z, Setoid.ker g z (ofSubtype π z) := by
      intro π hπ z
      rw [Setoid.ker_def]
      by_cases hz : p z
      · have h1 : ofSubtype π z = (π ⟨z, hz⟩).1 := ofSubtype_apply_of_mem π hz
        have h2 : p (ofSubtype π z) := h1 ▸ (π ⟨z, hz⟩).2
        simp only [g, hz, h2, ↓reduceDIte]
        congr 1
        apply Quotient.sound
        have : (⟨ofSubtype π z, h2⟩ : Subtype p) = π ⟨z, hz⟩ := Subtype.ext h1
        rw [this]
        exact hπ _
      · rw [ofSubtype_apply_of_not_mem π hz]
    have := compSetoid_le (Setoid.ker g) (key σ (compSetoid_left σ α))
      (key α (compSetoid_right σ α)) h
    rw [Setoid.ker_def] at this
    simp only [g, a.2, b.2, ↓reduceDIte, Sum.inl.injEq] at this
    exact Quotient.exact this

theorem compSetoid_ofSubtype_out (σ α : Perm (Subtype p)) (u v : D) (hu : ¬ p u)
    (h : compSetoid (ofSubtype σ) (ofSubtype α) u v) : u = v := by
  have := compSetoid_le (Setoid.ker fun w => if p w then none else some w)
    (fun z => by
      rw [Setoid.ker_def]
      by_cases hz : p z
      · have h1 := ofSubtype_apply_of_mem σ hz
        have h2 : p (ofSubtype σ z) := h1 ▸ (σ ⟨z, hz⟩).2
        simp [hz, h2]
      · rw [ofSubtype_apply_of_not_mem σ hz])
    (fun z => by
      rw [Setoid.ker_def]
      by_cases hz : p z
      · have h1 := ofSubtype_apply_of_mem α hz
        have h2 : p (ofSubtype α z) := h1 ▸ (α ⟨z, hz⟩).2
        simp [hz, h2]
      · rw [ofSubtype_apply_of_not_mem α hz]) h
  rw [Setoid.ker_def] at this
  by_cases hv : p v
  · simp [hu, hv] at this
  · simpa [hu, hv] using this

/-- Adding darts fixed by both permutations does not change the defect. -/
theorem eulerDefect_ofSubtype [Finite D] (σ α : Perm (Subtype p)) :
    eulerDefect (ofSubtype σ) (ofSubtype α) = eulerDefect σ α := by
  have hK : numComponents (ofSubtype σ) (ofSubtype α) =
      numComponents σ α + Nat.card {x // ¬ p x} :=
    numClasses_eq_restrict _ p _ (fun a b => compSetoid_ofSubtype_iff p σ α a b)
      (compSetoid_ofSubtype_out p σ α)
  have hn : Nat.card D = Nat.card (Subtype p) + Nat.card {x // ¬ p x} := by
    rw [← Nat.card_sum]
    exact Nat.card_congr (Equiv.sumCompl p).symm
  unfold eulerDefect
  rw [← map_mul, hK, hn, cycleCount_ofSubtype, cycleCount_ofSubtype, cycleCount_ofSubtype]
  push_cast
  ring

end Subtype

